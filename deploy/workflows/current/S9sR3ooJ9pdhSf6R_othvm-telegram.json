  {
   "id": "036e0937-9c93-4c94-93f9-d5ea96aa57d6",
   "name": "Build Speak",
   "parameters": {
    "jsCode": "// OTHVM — build a free Google Translate TTS audio URL for the Telegram bot.\nconst j = $json || {};\nlet p = j.params;\nif (typeof p === 'string') { try { p = JSON.parse(p); } catch (e) { p = {}; } }\nif (!p || typeof p !== 'object' || Array.isArray(p)) p = {};\nconst text = String(p.text || j.text || '').replace(/\\s+/g, ' ').trim();\nif (!text) return [{ json: { ok: false, error: 'text is required for speak' } }];\nconst lang = String(p.lang || p.language || 'ar').trim() || 'ar';\nconst chatId = String(p.chatId || p.chat_id || 'REPLACE_WITH_TELEGRAM_CHAT_ID').trim();\nconst caption = String(p.caption || '').trim();\nconst chunk = text.length > 190 ? text.slice(0, 187) + '…' : text;\nconst url = 'https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=' + encodeURIComponent(lang) + '&q=' + encodeURIComponent(chunk);\nreturn [{ json: { operation: 'sendAudio', action: '', params: { chatId: chatId, fileUrl: url, caption: caption.slice(0, 900), disableNotification: p.disableNotification === true } } }];",
    "mode": "runOnceForAllItems"
   },
