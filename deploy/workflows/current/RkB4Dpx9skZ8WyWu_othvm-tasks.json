   "id": "2d2f0f1f-2ca7-439d-b757-10a547be044e",
   "name": "Local DB Body",
   "parameters": {
    "jsCode": "// OTHVM — shape a local notes/todos call for the generic DB tool.\nconst j = $json || {};\nlet p = j.params;\nif (typeof p === 'string') { try { p = JSON.parse(p); } catch (e) { p = {}; } }\nif (!p || typeof p !== 'object' || Array.isArray(p)) p = {};\nconst out = Object.assign({}, p);\ndelete out.tool;\ndelete out.params;\nconst op = String(p.operation || j.operation || 'read').toLowerCase();\nout.table_name = 'todos';\nif (['add','save','insert','write','update'].includes(op)) {\n  out.operation = 'write';\n  out.mode = out.mode || (op === 'update' ? 'update' : 'insert');\n  if (!out.data) {\n    const d = Object.assign({}, out);\n    for (const k of ['operation','mode','table_name','data','filter','id','on_conflict','expected_version']) delete d[k];\n    out.data = d;\n  }\n} else {\n  out.operation = op;\n}\nreturn [{ json: out }];"
   },
