  {
   "id": "csn00100-4000-8000-000000000100",
   "name": "Output",
   "parameters": {
    "jsCode": "// OTHVM — Code Session: keep results compact and explicit.\nconst out = [];\nfor (const item of $input.all().slice(0, 3)) {\n  const j = item.json || {};\n  if (item.error) { const e = item.error; out.push({ json: { ok: false, error: String(e.message || e.description || e).slice(0, 800) } }); continue; }\n  const o = {};\n  for (const [k, v] of Object.entries(j)) {\n    if (v === null || v === undefined) continue;\n    if (typeof v === \"string\" && v.length > 8000) o[k] = v.slice(0, 8000) + \"…\";\n    else if (Array.isArray(v) && v.length > 200) { o[k] = v.slice(0, 200); o[k + \"_truncated\"] = v.length; }\n    else o[k] = v;\n  }\n  out.push({ json: o });\n}\nreturn out.length ? out : [{ json: { ok: false, error: \"no output from Code Session API\" } }];",
    "mode": "runOnceForAllItems"
   },
   "position": [
    540,
    0
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
  },
  {
   "id": "214851ef-cabd-43c4-aa2f-94d5beffa0a0",
   "name": "Expand Params",
   "parameters": {
    "jsCode": "// OTHVM — expand the generic params object into the flat fields the workflow expects.\nconst j = $json || {};\nlet p = j.params;\nif (typeof p === 'string') { try { p = JSON.parse(p); } catch (e) { p = {}; } }\nif (!p || typeof p !== 'object' || Array.isArray(p)) p = {};\nconst out = Object.assign({}, p);\nfor (const k of ['operation', 'action', 'category']) {\n  if (j[k] !== undefined && j[k] !== null && j[k] !== '') out[k] = j[k];\n}\nreturn [{ json: out }];",
    "mode": "runOnceForAllItems"
   },
   "position": [
    -40,
    0
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
