   "id": "kt017-4000-8000-000000000017",
   "name": "Build Items",
   "parameters": {
    "jsCode": "const files = $(\"File List\").all().map(i => i.json);\nconst reads = $input.all().map(i => i.json);\nconst items = [];\nfor (let i = 0; i < reads.length; i++) {\n  const f = files[i] || {};\n  const r = reads[i] || {};\n  const text = typeof r.data === \"string\" ? r.data : (r.content || \"\");\n  if (!text || String(text).length < 10) continue;\n  items.push({ source_id: f.fileId, title: f.name, content: \"# \" + f.name + \"\\n\\n\" + text, metadata: { fileId: f.fileId, source: \"drive\" } });\n}\nif (!items.length) return [];\nreturn [{ json: { operation: \"ingest\", source: \"drive\", items, chunk: true, replace_all: false } }];",
    "mode": "runOnceForAllItems"
   },
