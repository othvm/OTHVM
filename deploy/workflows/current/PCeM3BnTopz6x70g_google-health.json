   "id": "aa010300-000000000001",
   "name": "Summarize",
   "parameters": {
    "jsCode": "// OTHVM — summarize live Google credential health from the five probe nodes.\nconst check = (name) => {\n  try {\n    const first = $(name).first();\n    const j = (first && first.json) || {};\n    if (first && first.error) {\n      const e = first.error;\n      return { ok: false, error: String((e && (e.message || e.description)) || e).slice(0, 240) };\n    }\n    if (j.error) {\n      const e = j.error;\n      return { ok: false, error: String((e && (e.message || e.description)) || e).slice(0, 240) };\n    }\n    return { ok: true };\n  } catch (e) {\n    return { ok: false, error: String((e && e.message) || e).slice(0, 240) };\n  }\n};\nconst services = {\n  gmail: check('Gmail Profile'),\n  calendar: check('Calendar List'),\n  drive: check('Drive Files'),\n  tasks: check('Task Lists'),\n  contacts: check('Contacts Me'),\n};\nconst failed = Object.entries(services).filter(([, v]) => !v.ok).map(([k]) => k);\nreturn [{ json: { ok: failed.length === 0, checked_at: new Date().toISOString(), services, failed } }];",
    "mode": "runOnceForAllItems"
   },
