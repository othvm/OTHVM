  {
   "id": "776973ed-69d9-43d4-bc21-b4fc34559c1e",
   "name": "Flatten Params",
   "parameters": {
    "jsCode": "// OTHVM — flatten params; keep flat args, normalize action/operation, and expose merged params.\nconst j = $json || {};\nlet p = j.params;\nif (typeof p === 'string') { try { p = JSON.parse(p); } catch (e) { p = {}; } }\nif (!p || typeof p !== 'object' || Array.isArray(p)) p = {};\nconst out = {};\nfor (const [k, v] of Object.entries(j)) {\n  if (k === 'params') continue;\n  out[k] = v;\n}\nObject.assign(out, p);\nif (out.action === undefined && out.operation !== undefined) out.action = out.operation;\nif (out.operation === undefined && out.action !== undefined) out.operation = out.action;\nif (j.tool !== undefined) out.tool = j.tool;\n\nout.params = { ...out };\nreturn [{ json: out }];"
   },
   "position": [
    220,
    0
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
