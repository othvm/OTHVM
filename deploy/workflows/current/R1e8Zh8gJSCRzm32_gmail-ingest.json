   "parameters": {
    "jsCode": "const items = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  if (r.ok === false || !r.id) continue;\n  const date = r.internalDate ? new Date(Number(r.internalDate)).toISOString() : \"\";\n  const body = [\"Subject: \" + (r.Subject || r.subject || \"\"), \"From: \" + (r.From || r.from || \"\"), \"Date: \" + date, \"\", r.snippet || \"\"].join(\"\\n\").trim();\n  items.push({ source_id: r.id, title: r.Subject || r.subject || \"(no subject)\", content: body, metadata: { from: r.From || r.from || \"\", date, threadId: r.threadId || \"\" } });\n}\nif (!items.length) return [];\nreturn [{ json: { operation: \"ingest\", source: \"gmail\", items, chunk: true, replace_all: false } }];",
    "mode": "runOnceForAllItems"
