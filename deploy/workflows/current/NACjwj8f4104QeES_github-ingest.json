  {
   "id": "kt025-4000-8000-000000000025",
   "name": "Build Readme",
   "parameters": {
    "jsCode": "const metas = $(\"Readme Paths\").all().map(i => i.json);\nconst reads = $input.all().map(i => i.json);\nconst items = [];\nfor (let i = 0; i < reads.length; i++) {\n  const m = metas[i] || {};\n  const r = reads[i] || {};\n  if (!r.content) continue;\n  let text = \"\";\n  try { text = Buffer.from(String(r.content), \"base64\").toString(\"utf8\"); } catch (e) { text = String(r.content); }\n  if (!text.trim()) continue;\n  items.push({ source_id: m.full_name + \"/README\", title: m.full_name + \" — README\", content: \"# \" + m.full_name + \"\\n\\n\" + (m.description || \"\") + \"\\n\\n\" + text, metadata: { repo: m.full_name, url: m.html_url, source: \"github\" } });\n}\nif (!items.length) return [];\nreturn [{ json: { operation: \"ingest\", source: \"github_readme\", items, chunk: true, replace_all: false } }];",
    "mode": "runOnceForAllItems"
   },
