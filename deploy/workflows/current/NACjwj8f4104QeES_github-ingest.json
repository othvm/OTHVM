   "parameters": {
    "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  if (r.ok === false || !r.name) continue;\n  const full = r.full_name || r.name;\n  const parts = String(full).split(\"/\");\n  out.push({ json: { owner: parts[0] || full, repository: parts[1] || full, full_name: full, description: r.description || \"\", html_url: r.html_url || \"\" } });\n}\nreturn out;",
    "mode": "runOnceForAllItems"
