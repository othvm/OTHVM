  {
   "id": "kt023-4000-8000-000000000023",
   "name": "Readme Paths",
   "parameters": {
    "jsCode": "const repos = $(\"Repo List\").all().map(i => i.json);\nconst lists = $input.all().map(i => i.json);\nconst out = [];\nfor (let i = 0; i < lists.length; i++) {\n  const repo = repos[i] || {};\n  const r = lists[i] || {};\n  const arr = Array.isArray(r) ? r : (Array.isArray(r.items) ? r.items : [r]);\n  const readme = arr.find(x => x && /^readme/i.test(String(x.name || \"\")) && (x.type === \"file\" || !x.type));\n  if (!readme) continue;\n  out.push({ json: { owner: repo.owner, repository: repo.repository, full_name: repo.full_name, description: repo.description, html_url: repo.html_url, filePath: readme.name } });\n}\nreturn out;",
    "mode": "runOnceForAllItems"
