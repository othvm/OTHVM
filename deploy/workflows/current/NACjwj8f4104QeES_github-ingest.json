  {
   "id": "kt028-4000-8000-000000000028",
   "name": "Build Issues",
   "parameters": {
    "jsCode": "const items = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  if (r.ok === false || !r.number || !r.title) continue;\n  const repo = String(r.url || \"\").split(\"/repos/\")[1] ? String(r.url).split(\"/repos/\")[1].split(\"/issues/\")[0] : \"\";\n  const body = [\"#\" + r.number + \" \" + r.title, \"State: \" + (r.state || \"\"), \"User: \" + (r.user || \"\"), \"Created: \" + (r.created_at || \"\"), \"\", r.body || \"\", r.html_url || \"\"].join(\"\\n\");\n  items.push({ source_id: \"issue-\" + r.id, title: \"#\" + r.number + \" \" + r.title, content: body, metadata: { repo, url: r.html_url || \"\", state: r.state || \"\", source: \"github\" } });\n}\nif (!items.length) return [];\nreturn [{ json: { operation: \"ingest\", source: \"github_issues\", items, chunk: true, replace_all: false } }];",
    "mode": "runOnceForAllItems"
