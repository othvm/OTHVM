   "id": "aa030800-4000-8000-000000000000",
   "name": "sheet.appendOrUpdate — Build Rows",
   "parameters": {
    "jsCode": "// OTHVM — Sheets: حوّل dataJson (نص JSON أو كائن أو مصفوفة صفوف) لعناصر صفوف + حقول تحكم\nconst input = $input.first().json || {};\nlet data = input.dataJson;\nif (typeof data === 'string') {\n  const s = data.trim();\n  if (!s) throw new Error('dataJson فاضي — مرّر كائن صف أو مصفوفة صفوف JSON');\n  try {\n    data = JSON.parse(s);\n  } catch (e) {\n    throw new Error('dataJson مش JSON صالح: ' + e.message);\n  }\n}\nif (data === undefined || data === null) throw new Error('dataJson مطلوب (JSON string أو array/object)');\nif (!Array.isArray(data)) {\n  if (typeof data === 'object') data = [data];\n  else throw new Error('dataJson لازم يكون كائن صف أو مصفوفة صفوف');\n}\nif (!data.length) throw new Error('مصفوفة dataJson فاضية');\n// حقول التحكم تتنسخ لكل صف عشان تعبيرات عقدة Sheets تشتغل — وhandlingExtraData=ignoreIt بيمنعها من إنشاء أعمدة جديدة\nconst ctl = { spreadsheetId: input.spreadsheetId, sheetName: input.sheetName, columnToMatchOn: input.columnToMatchOn };\nconst rows = [];\nfor (const row of data) {\n  if (row === null || typeof row !== 'object' || Array.isArray(row)) {\n    throw new Error('كل صف في dataJson لازم يكون كائن {عمود: قيمة}');\n  }\n  rows.push({ json: Object.assign({}, row, ctl) });\n}\nreturn rows;",
    "mode": "runOnceForAllItems"
   },
