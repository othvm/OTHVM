   "name": "Output",
   "parameters": {
    "jsCode": "const out = [];\nfor (const item of $input.all().slice(0, 3)) {\n  const j = item.json || {};\n  if (item.error) { const e = item.error; out.push({ json: { ok: false, error: String(e.message || e.description || e).slice(0, 800) } }); continue; }\n  const o = {};\n  for (const [k, v] of Object.entries(j)) {\n    if (v === null || v === undefined) continue;\n    if (typeof v === \"string\" && v.length > 12000) o[k] = v.slice(0, 12000) + \"…\";\n    else o[k] = v;\n  }\n  out.push({ json: o });\n}\nreturn out.length ? out : [{ json: { ok: false, error: \"no output from vision API\" } }];",
