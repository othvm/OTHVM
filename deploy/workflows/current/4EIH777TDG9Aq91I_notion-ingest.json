   "name": "Page List",
   "parameters": {
    "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  const arr = Array.isArray(r) ? r : (Array.isArray(r.results) ? r.results : [r]);\n  for (const p of arr) {\n    if (!p || !p.id) continue;\n    if (p.type && p.type !== \"page\") continue;\n    out.push({ json: { pageId: p.id, title: p.title || p.id, url: p.url || \"\" } });\n  }\n}\nreturn out;",
    "mode": "runOnceForAllItems"
