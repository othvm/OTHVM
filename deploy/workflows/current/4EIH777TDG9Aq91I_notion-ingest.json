  {
   "id": "kt007-4000-8000-000000000007",
   "name": "Build Items",
   "parameters": {
    "jsCode": "const pages = $(\"Page List\").all().map(i => i.json);\nconst reads = $input.all().map(i => i.json);\nconst items = [];\nfor (let i = 0; i < reads.length; i++) {\n  const p = pages[i] || {};\n  const r = reads[i] || {};\n  const raw = r.lines;\n  const arr = Array.isArray(raw) ? raw : (typeof raw === \"string\" ? [raw] : []);\n  const text = arr.join(\"\\n\").trim();\n  if (!text) continue;\n  items.push({ source_id: p.pageId, title: p.title, content: \"# \" + p.title + \"\\n\\n\" + text, metadata: { url: p.url, source: \"notion\" } });\n}\nif (!items.length) return [];\nreturn [{ json: { operation: \"ingest\", source: \"notion\", items, chunk: true, replace_all: false } }];",
    "mode": "runOnceForAllItems"
   },
